# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://nexflow:nexflow@localhost:5432/nexflow
POSTGRES_DB=nexflow
POSTGRES_USER=nexflow
POSTGRES_PASSWORD=changeme

# ─── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OSRM ───────────────────────────────────────────
OSRM_BASE_URL=http://localhost:5000

# ─── AI Service ─────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Optimizer Service ──────────────────────────────
OPTIMIZER_URL=http://localhost:8001

# ─── Auth ───────────────────────────────────────────
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=24h

# ─── CORS ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── SMS ────────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=

# ─── External APIs ──────────────────────────────────
WEATHER_API_KEY=
MAP_PROVIDER_KEY=

# ─── App ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DEMO_MODE=true
